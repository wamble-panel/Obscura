# ============================================================================
# OBSCURA STUDIO — environment variables
# ----------------------------------------------------------------------------
# Local:  copy this file to .env.local and fill it in
# Vercel: Settings -> Environment Variables -> add each one -> redeploy
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase -> Project Settings -> API Keys -> anon / public
# Safe to expose in the browser; row level security does the protecting.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- STRONGLY RECOMMENDED ---------------------------------------------------
# Supabase -> Project Settings -> API Keys -> service_role
# NEVER expose this in the browser. It lets admins create and delete team
# accounts from the Users page, and lets the daily cron flag overdue rentals.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string. Protects /api/keepalive from being called by strangers.
# Vercel automatically sends it as a Bearer token on scheduled runs.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=change-me-to-something-random

# --- OPTIONAL ---------------------------------------------------------------
# Your deployed URL. Used to build password-reset links that come back to the
# right place. Vercel usually infers this, so it is only needed for custom domains.
NEXT_PUBLIC_SITE_URL=https://obscura.vercel.app
